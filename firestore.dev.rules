rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Development-only sandbox. Do not deploy these rules to a real project:
    // family membership + trusted invites are deliberately deferred to F2.
    match /dev_users/{userId}/operations/{operationId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validOperation() {
        let d = request.resource.data;
        return d.keys().hasOnly([
          'schemaVersion', 'actorId', 'sessionId', 'parentIds', 'deleted',
          'recordedAtUtc', 'startedAtUtc', 'endedAtUtc'
        ])
        && d.keys().hasAll([
          'schemaVersion', 'actorId', 'sessionId', 'parentIds', 'deleted',
          'recordedAtUtc', 'startedAtUtc', 'endedAtUtc'
        ])
        && d.schemaVersion == 1
        && d.actorId == userId
        && d.sessionId is string && d.sessionId.size() > 0
        && d.sessionId.size() <= 128
        && d.parentIds is list && d.parentIds.size() <= 20
        && d.deleted is bool
        && d.recordedAtUtc is timestamp
        && d.startedAtUtc is timestamp
        && (d.endedAtUtc == null ||
          (d.endedAtUtc is timestamp
            && d.endedAtUtc > d.startedAtUtc
            && d.endedAtUtc - d.startedAtUtc <= duration.value(24, 'h')));
      }

      allow read: if isOwner();
      allow create: if isOwner() && validOperation();
      allow update, delete: if false; // Immutable audit trail.
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
