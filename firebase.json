{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [{ "source": "functions", "codebase": "family" }],
  "hosting": {
    "public": "hosting",
    "predeploy": ["node scripts/check-hosting-ready.mjs"],
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [{
      "source": "**",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    }]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
